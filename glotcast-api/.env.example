# GlotCast API — copy to .env and fill in. Never commit .env.
# Empty = unset. External services are optional: a route whose service is not configured answers 503.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────────────────────────────────
# Local development: `npm run db:local` starts a throwaway Postgres on :54329 (data in .pgdata/).
DATABASE_URL=postgresql://postgres@localhost:54329/glotcast
# Production (Supabase project aoayqnsusoxjodjoxqaj, the same database Strapi uses; this API owns schema `app`):
#   Supabase dashboard → Connect → "Transaction pooler" (port 6543) — fine for the API (unnamed queries only):
# DATABASE_URL=postgresql://postgres.aoayqnsusoxjodjoxqaj:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Migrations need a session connection: Connect → "Session pooler" (port 5432). Used by `db-migrate`.
# DATABASE_MIGRATION_URL=postgresql://postgres.aoayqnsusoxjodjoxqaj:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=false
# With DATABASE_SSL=true: the Supabase CA — Project Settings → Database → SSL Configuration → Download
# certificate. The PEM itself (multiline, or one line with \n escapes) or a path to it.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10

# Only for `migrate-strapi` (read-only): the database Strapi writes. Empty = DATABASE_URL (production: same DB).
STRAPI_DATABASE_URL=
# The Strapi panel's public URL: prefixes upload URLs stored as "/uploads/…" (podcast covers uploaded in Strapi).
STRAPI_PUBLIC_URL=

# ── HTTP ──────────────────────────────────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (the admin panel). The mobile app needs none.
CORS_ORIGINS=http://localhost:3001
# Proxies in front of the API (0 locally; 1 behind Coolify's Traefik; 2 with Cloudflare proxying too).
TRUST_PROXY=0
# Requests per minute per client IP, on every route.
RATE_LIMIT_PER_MINUTE=120

# ── Supabase Auth ─────────────────────────────────────────────────────────────────────────────────────────
# The app signs in with Supabase (Apple, Google, anonymous guests); the API verifies access tokens against the
# project's JWKS. Unset = the user routes answer 503.
# SUPABASE_URL=https://aoayqnsusoxjodjoxqaj.supabase.co
SUPABASE_URL=
# Server only — deletes auth users (DELETE /v1/me, a claimed guest). Project Settings → API Keys → Secret key
# (sb_secret_…; a legacy service_role JWT works too).
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still signs tokens with the legacy shared secret: Project Settings → JWT Keys → Legacy JWT
# secret. New projects use asymmetric keys (JWKS) and need nothing here.
SUPABASE_JWT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────────────────────────────────
# GET /v1/app/config: older app versions are asked to update.
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0

# ── Translation and dictionary ────────────────────────────────────────────────────────────────────────────
# Google Cloud Translation v2 (Basic): Google Cloud Console → APIs & Services → Credentials → API key, restricted
# to the Cloud Translation API (the key the old app shipped as EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY — rotate it:
# it was public).
GOOGLE_TRANSLATE_API_KEY=
# Yandex Dictionary (word lookup translations): https://yandex.com/dev/dictionary/ → API key (glotcast-vocab's
# YANDEX_DICT_KEY). Unset = Google's free endpoint only.
YANDEX_DICT_KEY=

# ── Cloudflare R2 (admin uploads, generated covers) ───────────────────────────────────────────────────────
# Cloudflare dashboard → R2: the account id (R2 overview), an API token with Object Read & Write on the bucket
# (Manage R2 API Tokens → Access Key ID / Secret Access Key), the bucket, and its public URL (custom domain or
# r2.dev). The same values as whisper-transcriber's .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Content pipeline (admin) ──────────────────────────────────────────────────────────────────────────────
# AssemblyAI dashboard → API Keys (whisper-transcriber's ASSEMBLYAI_API_KEY).
ASSEMBLYAI_API_KEY=
# platform.openai.com → API keys: cover prompts (gpt-4o-mini) and gpt-image-1 covers.
OPENAI_API_KEY=
# aistudio.google.com → Get API key: Gemini covers (the default image model).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ── Push notifications ────────────────────────────────────────────────────────────────────────────────────
# The API decides who gets which push and when; OneSignal only delivers. OneSignal dashboard → Settings →
# Keys & IDs: the App ID and an App API key (REST, "Key …" auth). Unset = sending answers 503.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# The scheduler (every 5 minutes) plans and sends nothing until this is true — whatever the admin's automations say.
NOTIFICATIONS_ENABLED=false
# Parallel OneSignal requests while dispatching.
ONESIGNAL_CONCURRENCY=4

# ── docker-compose / Coolify only (the admin panel's build) ───────────────────────────────────────────────
# ADMIN_API_URL=https://api.<domain>
# Project Settings → API Keys → Publishable key (sb_publishable_…): safe in a browser.
# SUPABASE_PUBLISHABLE_KEY=
