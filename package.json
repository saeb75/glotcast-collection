{
  "name": "glotcast-api",
  "version": "0.1.0",
  "description": "GlotCast API — catalog, listening, vocabulary, translation and the admin content pipeline",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "cli": "node dist/cli.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local": "sh scripts/local-db.sh",
    "openapi": "tsc -p tsconfig.json --outDir tools-dist --tsBuildInfoFile tools-dist/.tsbuildinfo && node tools-dist/cli.js openapi"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "wink-lemmatizer": "^3.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
