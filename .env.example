# GlotCast admin — copy to .env.local for `npm run dev`. Never commit .env.local.
# Every value is public (NEXT_PUBLIC_*: baked into the browser bundle at build time).

# The Supabase project the app signs in with (Project Settings → API Keys → Publishable key, sb_publishable_…).
# Admins sign in with an email code; their account needs app_metadata.role = "admin"
# (in the API: node dist/cli.js admin grant <email>).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The API's origin, e.g. https://api.<domain> (its CORS_ORIGINS must list this panel's origin).
# Empty in development: the panel calls /v1 on its own origin and `next dev` forwards it to the local API.
NEXT_PUBLIC_API_URL=

# Development only: where `next dev` forwards /v1 (default http://localhost:3000, the API's `npm run start:dev`).
API_PROXY_URL=
